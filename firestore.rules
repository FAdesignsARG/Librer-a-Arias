rules_version = '2';

/**
 * Reglas de acceso a Firestore.
 *
 * El sitio público NUNCA lee Firestore directamente: consume el HTML/JSON
 * estático que genera `npm run build` (que sí lee Firestore, pero con la
 * clave de servicio del Admin SDK, que ignora estas reglas por diseño —
 * son reglas para el SDK de cliente, el que corre en el navegador).
 *
 * El único que toca Firestore desde el navegador es el panel de admin, y
 * sólo se llega a esa pantalla logueado. Por eso alcanza con "¿hay una
 * sesión válida?" — no hace falta una lista de UIDs autorizados, porque la
 * única forma de tener una cuenta es que Fran la haya creado a mano en la
 * consola de Firebase (no hay pantalla de registro en ningún lado del
 * sitio).
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{slug} {
      allow read, write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
