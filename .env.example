# Copiá este archivo como  .env  y completá lo que falte.
# El .env NO se sube a git ni se publica: las claves viven sólo en el servidor.
#
# La clave se saca gratis en https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales: sólo si querés cambiar de modelo.
# GROQ_MODEL_TEXT=llama-3.3-70b-versatile
# GROQ_MODEL_VISION=qwen/qwen3.6-27b

# Nombre del archivo de la clave de servicio de Firebase (Project settings →
# Service accounts → Generate new private key). Va en la raíz del proyecto.
# Sólo para desarrollo local — en Netlify no hay archivo, ver abajo.
FIREBASE_SERVICE_ACCOUNT=

# Alternativa para Netlify (o cualquier CI): el contenido completo del JSON
# de la clave de servicio, pegado tal cual como variable de entorno. Si está
# seteada, gana por sobre FIREBASE_SERVICE_ACCOUNT. No usar las dos a la vez
# en local, alcanza con una.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary: cloud name y preset NO van acá — no son secretos (viven en
# src/cloudinary-config.js, committeado, igual que la config de Firebase).
