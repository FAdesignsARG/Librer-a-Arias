# Copiá este archivo como  .env  y completá lo que falte.
# El .env NO se sube a git ni se publica: las claves viven sólo en el servidor.
#
# La clave se saca gratis en https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales: sólo si querés cambiar de modelo.
# GROQ_MODEL_TEXT=llama-3.3-70b-versatile
# GROQ_MODEL_VISION=qwen/qwen3.6-27b

# Nombre del archivo de la clave de servicio de Firebase (Project settings →
# Service accounts → Generate new private key). Va en la raíz del proyecto.
# Sólo para desarrollo local — en Netlify no hay archivo, ver abajo.
FIREBASE_SERVICE_ACCOUNT=

# Alternativa para Netlify (o cualquier CI): el contenido completo del JSON
# de la clave de servicio, pegado tal cual como variable de entorno. Si está
# seteada, gana por sobre FIREBASE_SERVICE_ACCOUNT. No usar las dos a la vez
# en local, alcanza con una.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary: cloud name y preset NO van acá — no son secretos (viven en
# src/cloudinary-config.js, committeado, igual que la config de Firebase).

# ---------- Publicación e integración con Base44 (sólo Netlify) ----------
# Valores reales SÓLO en Netlify → Site settings → Environment variables.
# Nunca en el repo, ni en mensajes técnicos, ni en logs.

# URL secreta del build hook de Netlify (Site settings → Build hooks).
# /api/rebuild la llama; sin ella responde 503.
BUILD_HOOK_URL=

# Secreto que Base44 manda en x-rebuild-token para pedir una publicación.
# Sin él, /api/rebuild sólo atiende al panel con sesión.
REBUILD_TOKEN=

# Secreto que Base44 manda en x-catalogo-token para /api/productos
# (crear, actualizar, ocultar, habilitar). Sin él, el endpoint está cerrado.
CATALOGO_WRITE_TOKEN=

# 1 = Base44 puede publicar directo (publish:true, o habilitar un producto
# "para revisar"). Vacío = entra oculto y se publica desde el panel.
CATALOGO_PUBLICAR_DIRECTO=

# Aviso web → Base44 cuando el panel cambia un producto
# (netlify/functions/base44-aviso.js). Sin la URL no se avisa nada.
# El token va en el header x-sync-token.
BASE44_PRODUCT_SYNC_URL=
BASE44_PRODUCT_SYNC_TOKEN=
